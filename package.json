{
  "name": "@jacklastone/download-manager",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/WMAIGC/aigc-download-manager.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "description": "Promise-first browser download queue with concurrency limit, priority scheduling, retry and AbortSignal cancellation.",
  "type": "module",
  "main": "./dist/download-manager.cjs",
  "module": "./dist/download-manager.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/download-manager.js",
      "require": "./dist/download-manager.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run test && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "download",
    "queue",
    "concurrency",
    "browser",
    "fetch",
    "abort",
    "retry"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.0",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  }
}
